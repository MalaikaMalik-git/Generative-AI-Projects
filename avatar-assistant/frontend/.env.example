# Only needed for production builds where the backend isn't on localhost:8000.
# Leave this file absent (or the var empty) for normal local development —
# the app falls back to http://localhost:8000 automatically.
#
# Copy to .env and set the real value before `npm run build` for deployment:
# VITE_BACKEND_URL=https://your-backend.onrender.com
VITE_BACKEND_URL=
